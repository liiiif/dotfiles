{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/skull.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ->  "
  },
  "modules": [
    {
      "type": "title",
      "key": "OS",
      "keyColor": "cyan"
    },
    {
      "type": "os",
      "key": "├─ 󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "├─ 󰌽 Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "├─ 󰏖 Packages",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "├─ 󰞌 Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "├─ 󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "└─ 󰅐 Uptime",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "host",
      "key": "PC",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "├─ 󰍛 CPU",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "├─ 󰢮 GPU",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "├─ 󰑭 RAM",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "├─ 󰋊 Disk (/)",
      "keyColor": "cyan",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "└─ 󰁹 Battery",
      "keyColor": "cyan"
    },

    "break",

{
      "type": "uptime",
      "key": "UP",
      "keyColor": "cyan"
    },
    {
    "type": "datetime",
    "format": "{1}-{3}-{11}",
    "key": "├─ ",
    "keyColor": "cyan"
    },    {
    "type": "command",
    "key": "└─  ",
    "keyColor": "cyan",
    "text" : "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"

    }

  ]
}